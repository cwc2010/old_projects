+<script>
+// RLE Parser and Handler
+function parseRLE(rleString) {
+  const lines = rleString.trim().split('\n');
+  let pattern = [];
+  let width = 0, height = 0;
+  let rule = null;
+  let patternLines = [];
+  
+  for (let line of lines) {
+    line = line.trim();
+    if (line.startsWith('#')) continue; // comment
+    if (line.includes('x =') || line.includes('x=')) {
+      // header line
+      const match = line.match(/x\s*=\s*(\d+),\s*y\s*=\s*(\d+)(?:,\s*rule\s*=\s*([^\s]+))?/i);
+      if (match) {
+        width = parseInt(match[1]);
+        height = parseInt(match[2]);
+        rule = match[3] || 'B3/S23';
+      }
+    } else {
+      patternLines.push(line);
+    }
+  }
+  
+  const patternStr = patternLines.join('');
+  let x = 0, y = 0;
+  let runCount = '';
+  
+  for (let i = 0; i < patternStr.length; i++) {
+    const char = patternStr[i];
+    
+    if (char >= '0' && char <= '9') {
+      runCount += char;
+    } else if (char === 'b' || char === '.') {
+      // dead cells
+      const count = runCount ? parseInt(runCount) : 1;
+      x += count;
+      runCount = '';
+    } else if (char === 'o' || char === 'A') {
+      // live cells
+      const count = runCount ? parseInt(runCount) : 1;
+      for (let j = 0; j < count; j++) {
+        pattern.push({x, y});
+        x++;
+      }
+      runCount = '';
+    } else if (char === '$') {
+      // end of line
+      const count = runCount ? parseInt(runCount) : 1;
+      y += count;
+      x = 0;
+      runCount = '';
+    } else if (char === '!') {
+      // end of pattern
+      break;
+    }
+  }
+  
+  return { pattern, width, height, rule };
+}
+
+function rotatePattern(pattern, degrees) {
+  if (degrees === 0) return pattern;
+  
+  const rad = degrees * Math.PI / 180;
+  const cos = Math.round(Math.cos(rad));
+  const sin = Math.round(Math.sin(rad));
+  
+  return pattern.map(cell => ({
+    x: cell.x * cos - cell.y * sin,
+    y: cell.x * sin + cell.y * cos
+  }));
+}
+
+function normalizePattern(pattern) {
+  if (pattern.length === 0) return pattern;
+  
+  let minX = pattern[0].x, minY = pattern[0].y;
+  for (const cell of pattern) {
+    if (cell.x < minX) minX = cell.x;
+    if (cell.y < minY) minY = cell.y;
+  }
+  
+  return pattern.map(cell => ({
+    x: cell.x - minX,
+    y: cell.y - minY
+  }));
+}
+
+// RLE Modal functionality
+const rleModal = document.getElementById('rleModal');
+const rleInput = document.getElementById('rleInput');
+const exampleSelect = document.getElementById('exampleSelect');
+const rlePlaceBtn = document.getElementById('rlePlaceBtn');
+const rleCancelBtn = document.getElementById('rleCancelBtn');
+const rleWarning = document.getElementById('rleWarning');
+const rleColorRed = document.getElementById('rleColorRed');
+const rleColorBlue = document.getElementById('rleColorBlue');
+const offsetXInput = document.getElementById('offsetX');
+const offsetYInput = document.getElementById('offsetY');
+const previewCanvas = document.getElementById('previewCanvas');
+const previewCtx = previewCanvas.getContext('2d');
+
+// Load examples
+async function loadExamples() {
+  try {
+    const response = await fetch('/examples.json');
+    if (response.ok) {
+      const examples = await response.json();
+      exampleSelect.innerHTML = '<option value="">-- Select an example --</option>';
+      for (const [name, rle] of Object.entries(examples)) {
+        const option = document.createElement('option');
+        option.value = rle;
+        option.textContent = name;
+        exampleSelect.appendChild(option);
+      }
+    }
+  } catch (e) {
+    console.log('Could not load examples:', e);
+  }
+}
+
+loadExamples();
+
+exampleSelect.addEventListener('change', (e) => {
+  if (e.target.value) {
+    rleInput.value = e.target.value;
+    validateRLE();
+  }
+});
+
+rleInput.addEventListener('input', validateRLE);
+
+function validateRLE() {
+  const rleStr = rleInput.value.trim();
+  if (!rleStr) {
+    rleWarning.style.display = 'none';
+    return;
+  }
+  
+  try {
+    const result = parseRLE(rleStr);
+    if (result.rule && result.rule !== 'B3/S23') {
+      rleWarning.textContent = `Warning: Pattern uses rule "${result.rule}" but will be inserted using standard B3/S23 rules.`;
+      rleWarning.style.display = 'block';
+    } else {
+      rleWarning.style.display = 'none';
+    }
+  } catch (e) {
+    rleWarning.textContent = 'Invalid RLE format';
+    rleWarning.style.display = 'block';
+  }
+}
+
+rleColorRed.addEventListener('click', () => {
+  rleColor = 1;
+  rleColorRed.classList.add('primary');
+  rleColorBlue.classList.remove('primary');
+});
+
+rleColorBlue.addEventListener('click', () => {
+  rleColor = 2;
+  rleColorBlue.classList.add('primary');
+  rleColorRed.classList.remove('primary');
+});
+
+document.querySelectorAll('[data-rotation]').forEach(btn => {
+  btn.addEventListener('click', (e) => {
+    document.querySelectorAll('[data-rotation]').forEach(b => b.classList.remove('primary'));
+    e.target.classList.add('primary');
+    rleRotation = parseInt(e.target.dataset.rotation);
+  });
+});
+
+offsetXInput.addEventListener('input', (e) => { rleOffsetX = parseInt(e.target.value) || 0; });
+offsetYInput.addEventListener('input', (e) => { rleOffsetY = parseInt(e.target.value) || 0; });
+
+function openRLEModal() {
+  rleModal.classList.add('active');
+}
+
+function closeRLEModal() {
+  rleModal.classList.remove('active');
+  previewCanvas.style.display = 'none';
+  document.removeEventListener('mousemove', updatePreview);
+  document.removeEventListener('click', placePattern);
+}
+
+rleCancelBtn.addEventListener('click', closeRLEModal);
+
+rlePlaceBtn.addEventListener('click', () => {
+  const rleStr = rleInput.value.trim();
+  if (!rleStr) return;
+  
+  try {
+    const result = parseRLE(rleStr);
+    let pattern = normalizePattern(rotatePattern(result.pattern, rleRotation));
+    rlePattern = pattern;
+    
+    rleModal.classList.remove('active');
+    previewCanvas.style.display = 'block';
+    
+    document.addEventListener('mousemove', updatePreview);
+    document.addEventListener('click', placePattern);
+  } catch (e) {
+    alert('Invalid RLE pattern');
+  }
+});
+
+function updatePreview(e) {
+  if (!rlePattern) return;
+  
+  const cellSize = 8;
+  const maxX = Math.max(...rlePattern.map(c => c.x));
+  const maxY = Math.max(...rlePattern.map(c => c.y));
+  
+  previewCanvas.width = (maxX + 1) * cellSize;
+  previewCanvas.height = (maxY + 1) * cellSize;
+  previewCanvas.style.left = (e.clientX + 10) + 'px';
+  previewCanvas.style.top = (e.clientY + 10) + 'px';
+  
+  previewCtx.clearRect(0, 0, previewCanvas.width, previewCanvas.height);
+  previewCtx.fillStyle = rleColor === 1 ? '#d33b3b' : '#3b8ad3';
+  
+  for (const cell of rlePattern) {
+    previewCtx.fillRect(cell.x * cellSize, cell.y * cellSize, cellSize - 1, cellSize - 1);
+  }
+}
+
+function placePattern(e) {
+  if (!rlePattern) return;
+  
+  const pos = screenToCell(e.clientX, e.clientY);
+  
+  for (const cell of rlePattern) {
+    setCell(pos.x + cell.x + rleOffsetX, pos.y + cell.y + rleOffsetY, rleColor);
+  }
+  
+  rlePattern = null;
+  previewCanvas.style.display = 'none';
+  document.removeEventListener('mousemove', updatePreview);
+  document.removeEventListener('click', placePattern);
+}
+</script>
