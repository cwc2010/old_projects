+function parseRLE(text){
+  // Strip comment lines and extract header
+  const lines = text.split(/\r?\n/).filter(l=>!l.trim().startsWith('#'));
+  const headerIdx = lines.findIndex(l=>/x\s*=/.test(l));
+  if(headerIdx === -1) throw new Error('RLE header not found (missing "x = ..., y = ...").');
+  const header = lines[headerIdx];
+  const m = header.match(/x\s*=\s*(\d+)\s*,\s*y\s*=\s*(\d+)(?:\s*,\s*rule\s*=\s*([A-Za-z0-9/]+))?/i);
+  if(!m) throw new Error('Malformed RLE header.');
+  const width = parseInt(m[1],10);
+  const height = parseInt(m[2],10);
+  const rule = (m[3]||'B3/S23').trim();
+  // Join the rest as pattern data
+  const data = lines.slice(headerIdx+1).join('').replace(/\s+/g,'');
+  let x=0,y=0,count=0;
+  const live = [];
+  for(let i=0;i<data.length;i++){
+    const ch = data[i];
+    if(ch>='0' && ch<='9'){ count = count*10 + (ch.charCodeAt(0)-48); continue; }
+    if(ch==='b' || ch==='o' || ch==='$' || ch==='!'){
+      const n = count || 1; count = 0;
+      if(ch==='b'){
+        x += n;
+      } else if(ch==='o'){
+        for(let k=0;k<n;k++){ live.push([x+k,y]); }
+        x += n;
+      } else if(ch==='$'){
+        y += n; x = 0;
+      } else if(ch==='!'){
+        break;
+      }
+    } else {
