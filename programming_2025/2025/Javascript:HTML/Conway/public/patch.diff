+  let maxX = 0, maxY = 0;
+  for(const [cx,cy] of live){ if(cx>maxX) maxX=cx; if(cy>maxY) maxY=cy; }
+  const w = Math.max(width, maxX+1);
+  const h = Math.max(height, maxY+1);
+  return {cells: live, width: w, height: h, rule};
+}
